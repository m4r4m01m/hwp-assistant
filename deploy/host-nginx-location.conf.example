# Replace ONLY the HWP Assistant locations inside the existing host server {}.
# Keep listen 127.0.0.1:80, Tailscale Funnel and other project locations unchanged.
location = /hwp-assistant { return 308 /hwp-assistant/; }
location /hwp-assistant/ {
    proxy_pass http://127.0.0.1:23000/;
    # Do not include proxy_params AND set X-Forwarded-Proto again: some Ubuntu
    # proxy_params files already define it, producing duplicate header values.
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    client_max_body_size 50m;
    proxy_read_timeout 240s;
}
