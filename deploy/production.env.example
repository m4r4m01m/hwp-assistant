# Prefer python3 scripts/deploy/init.py --env-file /opt/hwp-assistant/production.env
# Empty secrets intentionally prevent startup. Never commit the real file.
POSTGRES_PASSWORD=
HWP_AUTH_TOKENS=
HWP_LEGACY_OWNER=
HWP_ALLOWED_HOSTS=pseudowasabi-svr.taile7b6c4.ts.net,localhost,127.0.0.1,[::1]
# Browser login lifetime; SESSION_TTL_SECONDS is the separate document edit lease.
HWP_AUTH_SESSION_TTL_SECONDS=28800
HWP_AUTH_SESSION_IDLE_SECONDS=1800
HWP_AUTH_SESSION_MAX_PER_USER=20
HWP_IMAGE_PREFIX=ghcr.io/m4r4m01m/hwp-assistant
# deploy.sh exports the source commit SHA; do not use mutable latest tags.
HWP_IMAGE_TAG=
# Optional separate HTTP model. Codex is the default for the three primary AI flows.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
HWP_REWRITE_MAX_ACTIVE=1
# Immediate HTTP AI calls per user; the production API currently has one worker.
HWP_AI_REQUESTS_PER_MINUTE=20
# Comma-separated user IDs. Blank preserves access for all authenticated users.
# New init.py installations set only the initial owner; explicitly add other users.
HWP_LLM_ALLOWED_USERS=

# Explicit opt-in for password accounts. Keep legacy tokens for automation.
HWP_ACCOUNTS_ENABLED=0
HWP_REGISTRATION_ENABLED=0
HWP_REGISTRATION_REQUIRE_APPROVAL=1
# Choose shared explicitly for the approved-account challenge workspace.
# Historical document owners/ACLs are retained for a later private-mode transition.
HWP_LIBRARY_ACCESS_MODE=private
# Set 0 only after guest/admin password logins work; also retires token-derived cookies.
# Keep HWP_AUTH_TOKENS configured for compatibility with the production entrypoint.
HWP_LEGACY_TOKEN_ACCESS_ENABLED=1
# approved_accounts permits active approved members and guest; allowlist restores explicit IDs.
# An admin setting saved in the database takes precedence over this initial default.
HWP_CODEX_ACCOUNT_ACCESS=allowlist
# Secret incoming webhook URL; set only in the server's private env. Never commit it.
HWP_MATTERMOST_WEBHOOK_URL=
# HTTPS by default; opt in only for an explicitly trusted internal HTTP Mattermost.
HWP_MATTERMOST_ALLOW_HTTP=0
HWP_REGISTRATION_MAX_USERS=100
# Optional public synthetic cards, e.g. [{"user_id":"sample-a","label":"Sample A"}].
# Requires accounts enabled and existing active password accounts (account_admin).
# IDs/labels are public; never include passwords or personal profiles. No AI grants.
HWP_SAMPLE_ACCOUNTS=[]
# First-use seed only. Set the demo password privately or use account_admin.
# Never overwritten on restart; remove this entry after first successful seed.
HWP_GUEST_PASSWORD=
# Set to the actual account holder's app ID (not the shared guest identity).
HWP_CODEX_USER=
# Optional explicit IDs; blank uses HWP_CODEX_USER. No wildcard or signup grants.
HWP_CODEX_ALLOWED_USERS=
HWP_CODEX_MODEL=
HWP_CODEX_DAILY_REQUEST_LIMIT=60
HWP_REWRITE_PROVIDER=codex
HWP_DOCUMENT_ASSISTANT_PROVIDER=codex
# Preserve existing HTTP chat/review by default. To use this server's Codex login,
# explicitly set BOTH to codex; no separate HTTP model server is then required.
# Codex ACL/readiness/shared daily cap apply. No automatic fallback.
HWP_CHAT_PROVIDER=llm
HWP_REVIEW_PROVIDER=llm
