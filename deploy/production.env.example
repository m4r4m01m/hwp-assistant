# Prefer python3 scripts/deploy/init.py --env-file /opt/hwp-assistant/production.env
# Empty secrets intentionally prevent startup. Never commit the real file.
POSTGRES_PASSWORD=
HWP_AUTH_TOKENS=
HWP_LEGACY_OWNER=
HWP_ALLOWED_HOSTS=pseudowasabi-svr.taile7b6c4.ts.net,localhost,127.0.0.1,[::1]
# Browser login lifetime; SESSION_TTL_SECONDS is the separate document edit lease.
HWP_AUTH_SESSION_TTL_SECONDS=28800
HWP_AUTH_SESSION_IDLE_SECONDS=1800
HWP_AUTH_SESSION_MAX_PER_USER=20
HWP_IMAGE_PREFIX=ghcr.io/m4r4m01m/hwp-assistant
# deploy.sh exports the source commit SHA; do not use mutable latest tags.
HWP_IMAGE_TAG=
# Initially no AI connection. Ordinary document features work without a model.
# Review draft: explicit hosted presets and HTTP reports. See docs/llm-api-draft.md.
# Hosted presets: openrouter, nvidia (evaluation), openai (Chat Completions).
# They require an exact model ID, server key and LLM_ALLOW_EXTERNAL=true.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_ALLOW_EXTERNAL=false
LLM_RESPONSE_FORMAT=text
LLM_MAX_OUTPUT_TOKENS=8000
LLM_TEMPERATURE=0.2
# Blank is provider-specific. Set LLM_TEMPERATURE=omit for models that reject it.
LLM_TOKEN_LIMIT_PARAMETER=
# OpenRouter always disables fallback and denies data collection.
# Optional upstream restriction; blank does not pin the initial upstream provider.
LLM_OPENROUTER_PROVIDERS=
LLM_OPENROUTER_ZDR=false
HWP_DOCUMENT_ASSISTANT_PROVIDER=llm
# Default preserves Codex behavior. Set llm explicitly for supplied-material reports.
HWP_REPORT_PROVIDER=codex
HWP_REWRITE_MAX_ACTIVE=2
# HTTP AI calls and background jobs per user; production currently has one worker.
HWP_AI_REQUESTS_PER_MINUTE=20
# Comma-separated user IDs. Blank preserves access for all authenticated users.
# New init.py installations set only the initial owner; explicitly add other users.
HWP_LLM_ALLOWED_USERS=
