{
  "name": "hwp-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node ../scripts/build-frontend.mjs",
    "engine": "node ../scripts/build-engine.mjs",
    "engine:core": "node ../scripts/export-release-core.mjs",
    "test:engine-build": "node --test ../scripts/engine-build.test.mjs",
    "test:e2e": "playwright test",
    "test:unit": "node --test unit/*.test.mjs",
    "test:ui": "playwright test --config playwright.ui.config.ts"
  },
  "dependencies": {
    "@rhwp/core": "0.8.6",
    "@rhwp/editor": "0.8.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "fflate": "0.8.3",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
