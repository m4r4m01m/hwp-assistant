# Local examples only. No remote or paid API fallback.
# Hosted provider examples and explicit opt-in: docs/llm-api-draft.md
POSTGRES_DB=hwp_assistant
POSTGRES_USER=hwp_assistant
POSTGRES_PASSWORD=local-development-only
LLM_PROVIDER=openai-compatible
# Compose -> developer PC. Native backend -> http://127.0.0.1:1234/v1
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=google/gemma-4-e4b
LLM_TIMEOUT_SECONDS=30
LLM_ALLOW_EXTERNAL=false
LLM_RESPONSE_FORMAT=text
LLM_MAX_OUTPUT_TOKENS=8000
LLM_TEMPERATURE=0.2
# Blank uses max_completion_tokens for openai, max_tokens for other presets.
LLM_TOKEN_LIMIT_PARAMETER=
LLM_OPENROUTER_PROVIDERS=
LLM_OPENROUTER_ZDR=false
SESSION_TTL_SECONDS=120
# Optional multi-user mode: JSON object mapping user ID to a unique random token (24+ chars).
# Empty means one local development user; it is not multi-user authentication.
HWP_AUTH_TOKENS=
# Explicit owner when migrating existing public/local documents to authenticated mode.
HWP_LEGACY_OWNER=
# Native server's own logged-in ChatGPT/Codex account mapping (never share auth files).
# With authentication enabled, set to that account holder's app user ID.
HWP_CODEX_USER=local
HWP_CODEX_API_URL=http://127.0.0.1:8000
# Candidate generation only: codex (default) or llm (configured LlmProvider).
# No automatic fallback. llm needs LLM_* above, not Codex/MCP/login.
HWP_REWRITE_PROVIDER=codex
# Reports keep the existing Codex path unless explicitly set to llm.
# llm reports accept supplied material only; public web research is unsupported.
HWP_REPORT_PROVIDER=codex
